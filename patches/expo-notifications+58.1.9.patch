+    // Hams_Alarm: ringing alarms/timers (category "arrivering") take over the screen like a real
+    // alarm clock — full-screen intent launches the app over the lock screen and wakes the display.
+    if (notificationContent.categoryId == "arrivering") {
+      context.packageManager.getLaunchIntentForPackage(context.packageName)?.let { launch ->
+        launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+        launch.putExtra("hamsAlarmRing", true)
+        val fullScreen = PendingIntent.getActivity(
+          context,
+          notification.notificationRequest.identifier.hashCode(),
+          launch,
+          PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        builder.setFullScreenIntent(fullScreen, true)
+        builder.setCategory(NotificationCompat.CATEGORY_ALARM)
+      }
+    }
